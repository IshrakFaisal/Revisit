{
  "manifest_version": 3,
  "name": "Revisit",
  "version": "0.6.0",
  "description": "Save supported links to Revisit and send authorized foreground X, Facebook and GitHub arrivals to the running local app.",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab", "contextMenus", "scripting"],
  "optional_host_permissions": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*", "https://mobile.twitter.com/*", "https://facebook.com/*", "https://www.facebook.com/*", "https://m.facebook.com/*", "https://mbasic.facebook.com/*", "https://github.com/*", "https://www.github.com/*", "https://gist.github.com/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "incognito": "not_allowed"
}
